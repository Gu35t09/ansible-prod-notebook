#!/bin/bash
# {{ ansible_managed }}
# ClamAV scan of the configured paths, with a Telegram report.
# find builds the list of files (excluded paths pruned, size limit, one
# filesystem per path), then clamdscan scans it through the daemon.
# Exit codes follow ClamAV: 0 clean, 1 threats found, 2 error.
set -u

ACTION={{ clamav_action_on_detect | quote }}
QUARANTINE_DIR={{ clamav_quarantine_dir | quote }}
CONFIGURED_PATHS=({% for path in clamav_scan_paths %}{{ path | quote }}{{ ' ' if not loop.last }}{% endfor %})
EXCLUDE_PATHS=({% for path in clamav_exclude_paths %}{{ path | quote }}{{ ' ' if not loop.last }}{% endfor %})
MAX_SIZE_MB={{ clamav_max_file_size_mb | int }}
NOTIFY_CLEAN={{ clamav_notify_clean | bool | string | lower | quote }}
LOG_DIR={{ clamav_log_dir | quote }}
LOG_RETENTION_DAYS={{ clamav_log_retention_days | int }}
LABEL={{ notify_host_label | quote }}
# Jinja stops here: the rest is plain bash, where array lengths look like Jinja comments.
{% raw %}
LOG_FILE="${LOG_DIR}/scan_$(date +%Y%m%d_%H%M%S).log"
HOST=$(hostname)

# Under /run, never scanned.
WORK=$(mktemp -d /run/clamav-scan.XXXXXX)
trap 'rm -rf "$WORK"' EXIT

mkdir -p "$LOG_DIR"
if [ "$ACTION" = "quarantine" ]; then
    mkdir -p "$QUARANTINE_DIR" && chmod 700 "$QUARANTINE_DIR"
fi

# Remove scan logs older than the retention period
find "$LOG_DIR" -maxdepth 1 -name 'scan_*.log' -mtime +"$LOG_RETENTION_DAYS" -delete

notify() {
    if ! /usr/local/sbin/notify-telegram "$1" >> "$LOG_FILE" 2>&1; then
        echo "ERROR: Telegram notification not sent." >> "$LOG_FILE"
    fi
}

echo "=== ClamAV scan on $HOST: $(date) ===" > "$LOG_FILE"

# Skip paths that do not exist
SCAN_PATHS=()
for path in "${CONFIGURED_PATHS[@]}"; do
    if [ -e "$path" ]; then
        SCAN_PATHS+=("$path")
    else
        echo "WARNING: $path does not exist, skipped." >> "$LOG_FILE"
    fi
done
if [ ${#SCAN_PATHS[@]} -eq 0 ]; then
    notify "❌ CLAMAV: SCAN ERROR

${LABEL}: ${HOST}
None of the configured paths exists."
    exit 2
fi

# The file list: excluded trees pruned, other filesystems (USB sticks, network
# shares) not entered, files above the size limit left out.
prune=()
for path in "${EXCLUDE_PATHS[@]}"; do
    prune+=(-path "$path" -o)
done
if [ ${#prune[@]} -gt 0 ]; then
    unset 'prune[-1]'
    find "${SCAN_PATHS[@]}" -xdev \( "${prune[@]}" \) -prune -o -type f -size -"${MAX_SIZE_MB}"M -print > "$WORK/files" 2>> "$LOG_FILE"
else
    find "${SCAN_PATHS[@]}" -xdev -type f -size -"${MAX_SIZE_MB}"M -print > "$WORK/files" 2>> "$LOG_FILE"
fi
file_count=$(wc -l < "$WORK/files")
echo "Files to scan: $file_count (paths: ${SCAN_PATHS[*]})" >> "$LOG_FILE"

# clamdscan through the daemon is much faster; clamscan is the fallback.
# --fdpass: clamdscan (root) opens each file and hands it to clamd, which runs
# as the clamav user and could not open the homes (mode 0700) by itself.
if systemctl is-active --quiet clamav-daemon; then
    SCAN_CMD=(clamdscan --multiscan --fdpass --file-list="$WORK/files")
else
    echo "WARNING: clamav-daemon is not running, using clamscan (slower)." >> "$LOG_FILE"
    SCAN_CMD=(clamscan --file-list="$WORK/files")
fi

if [ "$ACTION" = "quarantine" ]; then
    SCAN_CMD+=("--move=$QUARANTINE_DIR")
elif [ "$ACTION" = "remove" ]; then
    SCAN_CMD+=(--remove=yes)
fi

"${SCAN_CMD[@]}" >> "$LOG_FILE" 2>&1
EXIT_CODE=$?

if [ $EXIT_CODE -eq 1 ]; then
    infected=$(grep -i "Infected files:" "$LOG_FILE" | awk '{print $3}')
    found=$(grep "FOUND$" "$LOG_FILE" | head -n 20)
    notify "⚠️ CLAMAV: MALWARE DETECTED

${LABEL}: ${HOST}
🦠 Infected files: ${infected}
🛠️ Action: ${ACTION}
📁 Scanned paths: ${SCAN_PATHS[*]}

📋 Detected files (max 20):
${found}

Full log: ${LOG_FILE}
See the maintenance guide, \"Malware detected\"."
elif [ $EXIT_CODE -gt 1 ]; then
    notify "❌ CLAMAV: SCAN ERROR

The scheduled scan on ${HOST} failed with exit code ${EXIT_CODE}.
Log: ${LOG_FILE}"
else
    echo "Scan completed. No threats found." >> "$LOG_FILE"
    if [ "$NOTIFY_CLEAN" = "true" ]; then
        summary=$(grep -i -A 10 "SCAN SUMMARY" "$LOG_FILE" | tail -n 10)
        notify "✅ CLAMAV: SCAN CLEAN

${LABEL}: ${HOST}
📁 Scanned paths: ${SCAN_PATHS[*]} (${file_count} files)

📋 Summary:
${summary:-$(tail -n 10 "$LOG_FILE")}"
    fi
fi

exit $EXIT_CODE
{% endraw %}
